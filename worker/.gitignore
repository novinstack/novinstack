# NovinStack / Tisa — repository root .gitignore
# Keep this file tracked. The local setup guide itself is intentionally ignored.

# Local-only setup documentation
/TISA_SETUP_GUIDE_FA.md

# Secrets and local environment variables (at any depth)
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
**/.dev.vars
**/.dev.vars.*
!**/.dev.vars.example
**/secrets.json
**/*.pem
**/*.key

# Node.js / Wrangler / generated artifacts
**/node_modules/
**/.wrangler/
**/.cache/
**/coverage/
**/dist/
**/build/
**/.turbo/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Local editor and OS files
/.vscode/
/.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak

# IMPORTANT — intentionally NOT ignored:
# /README.md, /README_EN.md, /assets/, /docs/, /docs/config.js,
# /worker/wrangler.toml, /worker/src/, /worker/package-lock.json
# Public Site Key and Worker URL can be stored in docs/config.js.
# NEVER store the Turnstile Secret Key in any tracked file.
